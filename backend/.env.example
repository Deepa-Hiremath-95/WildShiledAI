# Database — defaults to local SQLite; swap to Postgres for deployment
DATABASE_URL=sqlite:///./wildshield.db
# DATABASE_URL=postgresql://wildshield:wildshield@localhost:5432/wildshield

# Auth
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SMS — choose ONE path
SMS_PROVIDER=mock            # mock | twilio | gsm_module
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Alert tuning
DEFAULT_CONFIDENCE_THRESHOLD=0.6
DEFAULT_COOLDOWN_SECONDS=90
DEFAULT_SIREN_DURATION_SECONDS=45

# CORS — comma-separated list of allowed origins (e.g. your Vercel deployment URL)
CORS_ORIGINS=https://wildshield-ai.vercel.app,http://localhost:5173

# Optional edge API security for camera / inference scripts
EDGE_API_KEY=

# Optional Roboflow AI integration
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW=
