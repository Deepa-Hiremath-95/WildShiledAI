{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/alerts",
      "destination": "/frontend/alerts.html"
    },
    {
      "source": "/map-view",
      "destination": "/frontend/map-view.html"
    },
    {
      "source": "/siren-control",
      "destination": "/frontend/siren-control.html"
    },
    {
      "source": "/analytics",
      "destination": "/frontend/analytics.html"
    },
    {
      "source": "/notifications",
      "destination": "/frontend/notifications.html"
    },
    {
      "source": "/profile",
      "destination": "/frontend/profile.html"
    },
    {
      "source": "/security",
      "destination": "/frontend/security.html"
    },
    {
      "source": "/((?!backend|hardware|ai-model).*)",
      "destination": "/frontend/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
